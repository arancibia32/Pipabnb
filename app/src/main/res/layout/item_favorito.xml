<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="112dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="5dp"
    android:background="#EEEEEE">

    <!-- Fotografía -->
    <ImageView
        android:id="@+id/imgLugar"
        android:layout_width="90dp"
        android:layout_height="98dp"
        android:scaleType="centerCrop"

        android:contentDescription="Fotografía del lugar"/>

    <!-- Información -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/txtNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lugar ejemplo"
            android:textColor="#333333"
            android:textSize="15sp"
            android:maxLines="1"/>

        <TextView
            android:id="@+id/txtEstrellas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="★★★★☆"
            android:textColor="#2196F3"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/txtDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lorem ipsum dolor sit amet consectetur adipiscing elit"
            android:textColor="#888888"
            android:textSize="10sp"
            android:maxLines="2"
            android:ellipsize="end"/>

    </LinearLayout>

    <!-- Acciones -->
    <LinearLayout
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/btnDetalle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="›"
            android:textSize="28sp"
            android:textColor="#888888"
            android:contentDescription="Ver detalles"/>

        <TextView
            android:id="@+id/btnFavorito"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♡"
            android:textSize="23sp"
            android:textColor="#444444"
            android:contentDescription="Quitar de favoritos"/>

    </LinearLayout>

</LinearLayout>
